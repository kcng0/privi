+/* Signed subtitle clock arithmetic for both 32- and 64-bit Android.
+ * LGPL-2.1-or-later, like the surrounding VLC input implementation.
+ *
+ * Stream timestamps, delays and reference offsets are independently signed
+ * 64-bit values. Their sum times an input rate needs at most 100 bits. Keep
+ * that intermediate exact; reject only an unrepresentable stored result.
+ */
+#ifndef VLC_INPUT_SUBTITLE_DATE_H
+#define VLC_INPUT_SUBTITLE_DATE_H
+
+#include <stdint.h>
+#include <stdbool.h>
+#include <limits.h>
+
+typedef struct { uint64_t hi, lo; } subtitle_date_wide;
+
+static inline subtitle_date_wide SubtitleDateWide(int64_t value)
+{
+    return (subtitle_date_wide) { value < 0 ? UINT64_MAX : 0,
+                                 (uint64_t)value };
+}
+
+static inline subtitle_date_wide SubtitleDateAdd(subtitle_date_wide a,
+                                                 subtitle_date_wide b)
+{
+    const uint64_t lo = a.lo + b.lo;
+    return (subtitle_date_wide) { a.hi + b.hi + (lo < a.lo), lo };
+}
+
+static inline subtitle_date_wide SubtitleDateNegate(subtitle_date_wide a)
+{
+    const uint64_t lo = ~a.lo + 1;
+    return (subtitle_date_wide) { ~a.hi + (lo == 0), lo };
+}
+
+/* The caller's bound above ensures multiplication cannot overflow 128 bits. */
+static inline subtitle_date_wide SubtitleDateMultiply(subtitle_date_wide a,
+                                                       int32_t factor)
+{
+    const bool negative = (a.hi >> 63) != (factor < 0);
+    if (a.hi >> 63) a = SubtitleDateNegate(a);
+    const uint64_t multiplier = factor < 0 ? -(int64_t)factor : factor;
+    uint32_t parts[4] = { a.lo, a.lo >> 32, a.hi, a.hi >> 32 };
+    uint64_t carry = 0;
+    for (unsigned i = 0; i < 4; ++i) {
+        const uint64_t product = (uint64_t)parts[i] * multiplier + carry;
+        parts[i] = product;
+        carry = product >> 32;
+    }
+    a = (subtitle_date_wide) { ((uint64_t)parts[3] << 32) | parts[2],
+                              ((uint64_t)parts[1] << 32) | parts[0] };
+    return negative ? SubtitleDateNegate(a) : a;
+}
+
+/* Signed division rounds toward zero, exactly like the original C clock. */
+static inline subtitle_date_wide SubtitleDateDivide(subtitle_date_wide a,
+                                                     uint64_t divisor)
+{
+    const bool negative = a.hi >> 63;
+    if (negative) a = SubtitleDateNegate(a);
+    if (divisor > UINT32_MAX) {
+        subtitle_date_wide quotient = { 0, 0 };
+        uint64_t remainder = 0;
+        for (unsigned i = 128; i-- > 0;) {
+            const uint64_t bit = i >= 64 ? (a.hi >> (i - 64)) & 1
+                                         : (a.lo >> i) & 1;
+            const bool carry = remainder >> 63;
+            remainder = (remainder << 1) | bit;
+            if (carry || remainder >= divisor) {
+                remainder -= divisor;
+                if (i >= 64) quotient.hi |= UINT64_C(1) << (i - 64);
+                else quotient.lo |= UINT64_C(1) << i;
+            }
+        }
+        return negative ? SubtitleDateNegate(quotient) : quotient;
+    }
+    uint32_t parts[4] = { a.lo, a.lo >> 32, a.hi, a.hi >> 32 };
+    uint64_t remainder = 0;
+    for (unsigned i = 4; i-- > 0;) {
+        const uint64_t value = (remainder << 32) | parts[i];
+        parts[i] = value / divisor;
+        remainder = value % divisor;
+    }
+    a = (subtitle_date_wide) { ((uint64_t)parts[3] << 32) | parts[2],
+                              ((uint64_t)parts[1] << 32) | parts[0] };
+    return negative ? SubtitleDateNegate(a) : a;
+}
+
+static inline bool SubtitleDateStore(subtitle_date_wide value, int64_t *out)
+{
+    if (value.hi == 0 && value.lo <= INT64_MAX) {
+        *out = value.lo;
+        return true;
+    }
+    if (value.hi == UINT64_MAX && value.lo >= (UINT64_C(1) << 63)) {
+        /* Avoid implementation-defined unsigned-to-signed conversion. */
+        *out = -1 - (int64_t)~value.lo;
+        return true;
+    }
+    return false;
+}
+
+#endif
