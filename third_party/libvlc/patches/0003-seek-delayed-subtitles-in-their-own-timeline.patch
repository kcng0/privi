+/* A new unrepresentable date is an input timing error, not a normal slave
+ * EOF. Standalone/no-owner callers still receive the generic demux failure. */
+static void SubtitleTimingError( demux_t *p_demux, const char *message )
+{
+    msg_Err( p_demux, "%s", message );
+    if( p_demux->p_input != NULL )
+        input_Control( p_demux->p_input, INPUT_REPORT_SUBTITLE_TIMING_ERROR );
+}
+
+/* i_next_demux_date remains in the master/standalone timeline. Slave cue
+ * selection and progress use the same signed subtitle timeline. Standalone
+ * retains its existing negative-barrier fallback and PCR scheduling. */
+static bool SubtitleTimeSubtract( int64_t a, int64_t b, int64_t *result )
+{
+    if( ( b > 0 && a < INT64_MIN + b ) ||
+        ( b < 0 && a > INT64_MAX + b ) )
+        return false;
+    *result = a - b;
+    return true;
+}
+
+static bool SubtitleTimeAdd( int64_t a, int64_t b, int64_t *result )
+{
+    if( ( b > 0 && a > INT64_MAX - b ) ||
+        ( b < 0 && a < INT64_MIN - b ) )
+        return false;
+    *result = a + b;
+    return true;
+}
+
+static bool SubtitleRawTime( demux_t *p_demux, int64_t master_date,
+                          int64_t *subtitle_date )
+{
+    if( SubtitleTimeSubtract( master_date,
+            var_GetInteger( p_demux->obj.parent, "spu-delay" ), subtitle_date ) )
+        return true;
+    SubtitleTimingError( p_demux, "subtitle time minus delay is outside signed 64-bit range" );
+    return false;
+}
+
+static bool SubtitleTime( demux_t *p_demux, int64_t master_date,
+                          int64_t *subtitle_date )
+{
+    if( !SubtitleRawTime( p_demux, master_date, subtitle_date ) )
+        return false;
+    if( !p_demux->p_sys->b_slave && *subtitle_date < 0 )
+        *subtitle_date = master_date;
+    return true;
+}
+
+static bool SubtitleActiveAt( const demux_sys_t *p_sys, const subtitle_t *sub,
+                              int64_t target, size_t latest )
+{
+    if( sub->i_start > target )
+        return false;
+    const bool dated_stop = sub->i_stop != VLC_TICK_INVALID &&
+                            sub->i_stop > sub->i_start;
+    return dated_stop ? sub->i_stop > target
+           : latest < p_sys->subtitles.i_count &&
+             sub->i_start == p_sys->subtitles.p_array[latest].i_start;
+}
+
+/* Start with every still-active overlap, rather than only the last start.
+ * An undated/equal-time stop is ephemeral: only the latest start group may
+ * survive at the target. Preserve all cues in that group, not just its last
+ * member. A seek scans once for that group and once for the earliest survivor;
+ * ordinary demux does not repeat either scan. */
+static size_t SubtitleSeekIndex( const demux_sys_t *p_sys, int64_t target,
+                                 size_t *seek_latest )
+{
+    size_t latest = p_sys->subtitles.i_count;
+    for( size_t i = 0; i < p_sys->subtitles.i_count; ++i )
+    {
+        if( p_sys->subtitles.p_array[i].i_start > target )
+            break;
+        latest = i;
+    }
+    *seek_latest = latest;
+
+    for( size_t i = 0; i < p_sys->subtitles.i_count; ++i )
+    {
+        const subtitle_t *sub = &p_sys->subtitles.p_array[i];
+        if( sub->i_start > target || SubtitleActiveAt( p_sys, sub, target, latest ) )
+            return i;
+    }
+    return p_sys->subtitles.i_count;
+}
+
